<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Serilog.Sinks.Http</id>
    <version>9.2.1</version>
    <authors>Mattias Kindborg</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>serilog-sink-nuget.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/FantasticFiasco/serilog-sinks-http</projectUrl>
    <description>A Serilog sink sending log events over HTTP.</description>
    <releaseNotes>See https://github.com/FantasticFiasco/serilog-sinks-http/blob/main/CHANGELOG.md for details</releaseNotes>
    <copyright>Copyright 2015-2026 Serilog Contributors</copyright>
    <tags>serilog http</tags>
    <repository type="git" url="https://github.com/FantasticFiasco/serilog-sinks-http.git" commit="599d51e8130f3662426c8ef5fe92ac4fa3b3f2f6" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.File" version="7.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.File" version="7.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.File" version="7.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System.Net.Http" targetFramework=".NETFramework4.6.2" />
    </frameworkAssemblies>
  </metadata>
</package>