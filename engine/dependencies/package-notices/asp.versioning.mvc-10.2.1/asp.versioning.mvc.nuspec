<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Asp.Versioning.Mvc</id>
    <version>10.2.1</version>
    <authors>.NET Foundation and Contributors</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://dotnet.github.io/aspnet-api-versioning</projectUrl>
    <description>A service API versioning library for Microsoft ASP.NET Core MVC.</description>
    <releaseNotes>- Bump patched version due to transitive dependency</releaseNotes>
    <copyright>© .NET Foundation. All rights reserved.</copyright>
    <tags>Asp AspNet AspNetCore MVC Versioning</tags>
